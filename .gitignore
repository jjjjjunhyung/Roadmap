# Repository-wide safety net (this repository is public).
# Project folders may add their own .gitignore on top of this.

# Secrets and local-only settings
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.cloudflared/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
*.tfvars.*
!*.tfvars.example
backend.hcl

# OS / editor
.DS_Store
