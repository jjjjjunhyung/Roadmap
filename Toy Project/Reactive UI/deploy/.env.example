# /opt/reactive-ui/.env on the VM (chmod 600). Never commit the real file.
# TUNNEL_TOKEN: `terraform output -raw tunnel_token` in infra/
# APP_IMAGE:    written by deploy.sh on every deploy
# PLANNER_KEY:  random secret; planner pages live at /plan/<PLANNER_KEY>
# NAVER_MAP_CLIENT_ID: NCP console > Maps > Application > Client ID (optional)
# ARCHIVE_PASSCODE: 4-8 digits (e.g. a birthday as YYMMDD) for the archive at / (optional)
# TURNSTILE_SITE_KEY / TURNSTILE_SECRET: `terraform output -raw turnstile_site_key|turnstile_secret`
# BACKUP_URL: `terraform output -raw backup_url` (daily backup upload, write-only; optional)
TUNNEL_TOKEN=
APP_IMAGE=reactive-ui-app:<git-sha>
PLANNER_KEY=
NAVER_MAP_CLIENT_ID=
ARCHIVE_PASSCODE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
BACKUP_URL=
